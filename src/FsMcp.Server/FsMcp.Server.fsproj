<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>F# MCP server builder with computation expressions and typed cancellable handlers</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FsMcp.Sampling" />
    <InternalsVisibleTo Include="FsMcp.Server.Tests" />
    <InternalsVisibleTo Include="FsMcp.Server.Http" />
    <InternalsVisibleTo Include="FsMcp.Server.Http.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Handlers.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="DynamicServer.fs" />
    <Compile Include="Middleware.fs" />
    <Compile Include="TypedHandlers.fs" />
    <Compile Include="Streaming.fs" />
    <Compile Include="Notifications.fs" />
    <Compile Include="ToolBuilder.fs" />
    <Compile Include="ValidationMiddleware.fs" />
    <Compile Include="Telemetry.fs" />
    <Compile Include="Subscriptions.fs" />
    <Compile Include="StderrLogger.fs" />
    <Compile Include="Transport.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsMcp.Core/FsMcp.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[$(MicrosoftExtensionsVersion)]" />
    <PackageReference Include="ModelContextProtocol" Version="[$(ModelContextProtocolVersion)]" />
    <PackageReference Include="TypeShape" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="[$(MicrosoftExtensionsVersion)]" />
  </ItemGroup>

</Project>

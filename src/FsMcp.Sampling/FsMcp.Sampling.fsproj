<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>MCP sampling domain types and test helpers; legacy transport wiring fails closed in 2.0</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SamplingTypes.fs" />
    <Compile Include="SamplingHandler.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsMcp.Core/FsMcp.Core.fsproj" />
    <ProjectReference Include="../FsMcp.Server/FsMcp.Server.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="[$(ModelContextProtocolVersion)]" />
  </ItemGroup>

</Project>

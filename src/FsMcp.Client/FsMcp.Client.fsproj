<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Typed F# client for MCP, including Result-based error handling and enterprise-managed authorization</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ClientTransport.fs" />
    <Compile Include="EnterpriseManagedAuthorization.fs" />
    <Compile Include="EnterpriseManagedAuthorizationHandler.fs" />
    <Compile Include="McpClient.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsMcp.Core/FsMcp.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="[$(ModelContextProtocolVersion)]" />
  </ItemGroup>

</Project>
